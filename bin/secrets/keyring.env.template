# keyring.env — the agent keyring (used by bin/api.py and bin/gen_image.py)
#
# Copy this file to keyring.env in this same directory and fill in the keys
# you have. keyring.env is GITIGNORED — it never leaves your machine, and
# api.py redacts every value from anything it prints.
#
# Leave lines you don't need as-is (values containing "PASTE" are ignored).

YOUTUBE_API_KEY=PASTE_YOUR_KEY_HERE
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
GOOGLE_CLOUD_API_KEY=PASTE_YOUR_KEY_HERE
RESEND_API_KEY=PASTE_YOUR_KEY_HERE
SKETCHFAB_API_TOKEN=PASTE_YOUR_TOKEN_HERE

# Supabase is multi-project: one URL+KEY pair per project name.
# Service name becomes "supabase:myproj" in api.py calls.
SUPABASE_MYPROJ_URL=PASTE_YOUR_URL_HERE
SUPABASE_MYPROJ_KEY=PASTE_YOUR_KEY_HERE
